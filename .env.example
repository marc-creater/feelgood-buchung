# --- Datenbank (docker-compose setzt das automatisch) ---
DATABASE_URL=postgres://feelgood:feelgood@localhost:5432/feelgood

# --- App ---
APP_URL=http://localhost:3000            # öffentliche URL, wird in Links/E-Mails verwendet
STUDIO_NAME=Feelgood
STUDIO_TZ=Europe/Berlin
ADMIN_PASSWORD=bitte-aendern              # Login für /admin
SESSION_SECRET=bitte-langen-zufallsstring-eintragen
CRON_SECRET=bitte-aendern                 # schützt /api/cron/reminders

# --- E-Mail (SMTP, z. B. IONOS/Strato/Mailbox.org/Resend-SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Feelgood <info@cabrera-feelgood.de>"
MAIL_ADMIN=info@cuerpo.info               # bekommt Kopien (neue Buchung, Storno)

# --- WhatsApp Cloud API (optional; leer = Kanal deaktiviert, Fallback E-Mail/SMS) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_CONFIRMATION=termin_bestaetigung
WHATSAPP_TEMPLATE_REMINDER=termin_erinnerung
WHATSAPP_TEMPLATE_CANCELLATION=termin_absage
WHATSAPP_TEMPLATE_FREED=termin_frei
WHATSAPP_LANG=de

# --- SMS via seven.io (optional; leer = Kanal deaktiviert) ---
SEVEN_API_KEY=
SMS_SENDER=Feelgood
